{
  "info": {
    "_postman_id": "64890a17-8653-48ca-9be6-3309d3f0e78b",
    "name": "SupportHub API smoke tests",
    "description": "Read-only health, admin, reporting, and authorization checks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "API health and database connection",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('API and PostgreSQL are healthy', function () {",
              "  pm.response.to.have.status(200);",
              "  var body = pm.response.json();",
              "  pm.expect(body.status).to.eql('success');",
              "  pm.expect(body.message).to.include('PostgreSQL connected');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Administrator login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{adminPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Administrator can sign in', function () {",
              "  pm.response.to.have.status(200);",
              "  var body = pm.response.json();",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.user.role).to.eql('admin');",
              "  pm.expect(body.token).to.be.a('string');",
              "  pm.environment.set('adminToken', body.token);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "List users",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Administrator can list users', function () {",
              "  pm.response.to.have.status(200);",
              "  var body = pm.response.json();",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.users).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get reports",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/reports"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Reports have the expected shape', function () {",
              "  pm.response.to.have.status(200);",
              "  var body = pm.response.json();",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.reports.ticketStatus).to.be.an('array');",
              "  pm.expect(body.reports.agentPerformance).to.be.an('array');",
              "  pm.expect(body.reports.resolutionTime).to.be.an('object');",
              "  pm.expect(body.reports.ticketCategory).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject unauthenticated admin access",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/admin/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin routes require authentication', function () {",
              "  pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject an invalid role filter",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/users?role=invalid"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Invalid role filters are rejected', function () {",
              "  pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
